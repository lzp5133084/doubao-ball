<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DoubaoBall" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">#0A0E14</item>
        <item name="android:navigationBarColor">#0A0E14</item>
        <item name="android:windowBackground">#0A0E14</item>
    </style>

    <style name="CardTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">#FFD76A</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="HelpDot">
        <item name="android:layout_width">26dp</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:background">@drawable/circle_help</item>
        <item name="android:gravity">center</item>
        <item name="android:text">?</item>
        <item name="android:textColor">#FFD76A</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PermLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">#F5F0E1</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="GestureText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#F5F0E1</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="GoldBtn" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:backgroundTint">#D4AF37</item>
        <item name="android:textColor">#0A0E14</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="GoldBtnSmall" parent="Widget.Material3.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:backgroundTint">#D4AF37</item>
        <item name="android:textColor">#0A0E14</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="GhostBtn" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#9BA3B4</item>
    </style>
</resources>
